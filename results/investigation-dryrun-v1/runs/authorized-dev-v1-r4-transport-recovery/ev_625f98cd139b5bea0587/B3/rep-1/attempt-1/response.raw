          "text": "{\n  \"citation_mode\": \"required\",\n  \"claims\": [\n    {\n      \"asset_ids\": [],\n      \"channel_ids\": [],\n      \"claim_id\": \"c_0001\",\n      \"claim_text\": \"Observation m_6810641848b8126a6e492ae1 captured iec_i_frame at capture time 0.06701993942260742 s. This does not establish malicious activity.\",\n      \"claim_type\": \"network_activity\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"m_6810641848b8126a6e492ae1\"],\n      \"payload\": {\n        \"activity\": \"iec_i_frame\",\n        \"record_id\": \"m_6810641848b8126a6e492ae1\",\n        \"time\": 0.06701993942260742\n      },\n      \"question_ids\": [\"Q1\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [\"asset_961989964c2e8398\"],\n      \"channel_ids\": [],\n      \"claim_id\": \"c_0002\",\n      \"claim_text\": \"Observation m_6810641848b8126a6e492ae1 with address a_93964c75e9a16e00b740cdf0 and mapping meta_e60717f8bb899c47b3a54e4f captured a command-type activation request (ASDU 45, COT 6) addressed to control point cp_b3ee9db030eb9eb9 mapped to asset asset_961989964c2e8398 at capture time 0.06701993942260742 s. Execution is not established.\",\n      \"claim_type\": \"command_observed\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\n        \"m_6810641848b8126a6e492ae1\",\n        \"a_93964c75e9a16e00b740cdf0\",\n        \"meta_e60717f8bb899c47b3a54e4f\"\n      ],\n      \"payload\": {\n        \"address_evidence_id\": \"a_93964c75e9a16e00b740cdf0\",\n        \"asdu_type\": 45,\n        \"cause_of_transmission\": 6,\n        \"mapped_control_point_id\": \"cp_b3ee9db030eb9eb9\",\n        \"mapped_target_asset_id\": \"asset_961989964c2e8398\",\n        \"mapping_evidence_id\": \"meta_e60717f8bb899c47b3a54e4f\",\n        \"record_id\": \"m_6810641848b8126a6e492ae1\",\n        \"time\": 0.06701993942260742\n      },\n      \"question_ids\": [\"Q1\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n    