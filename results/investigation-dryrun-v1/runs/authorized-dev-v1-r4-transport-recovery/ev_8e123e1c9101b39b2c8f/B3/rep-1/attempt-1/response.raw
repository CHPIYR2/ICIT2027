          "text": "{\n  \"citation_mode\": \"required\",\n  \"claims\": [\n    {\n      \"asset_ids\": [],\n      \"channel_ids\": [],\n      \"claim_id\": \"c_0001\",\n      \"claim_text\": \"Observation m_a994e73c7a934146ef7edeea captured iec_i_frame at capture time 0.005490303039550781 s. This does not establish malicious activity.\",\n      \"claim_type\": \"network_activity\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"m_a994e73c7a934146ef7edeea\"],\n      \"payload\": {\n        \"activity\": \"iec_i_frame\",\n        \"record_id\": \"m_a994e73c7a934146ef7edeea\",\n        \"time\": 0.005490303039550781\n      },\n      \"question_ids\": [\"Q1\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [\"asset_7f51d170f933034a\"],\n      \"channel_ids\": [],\n      \"claim_id\": \"c_0002\",\n      \"claim_text\": \"Observation m_a994e73c7a934146ef7edeea with address a_f41a7c1ba6156fae3efcbfa8 and mapping meta_9de8727634f7ee1e0ff7ee65 captured a command-type activation request (ASDU 45, COT 6) addressed to control point cp_e5869e3453530c0a mapped to asset asset_7f51d170f933034a at capture time 0.005490303039550781 s. Execution is not established.\",\n      \"claim_type\": \"command_observed\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"m_a994e73c7a934146ef7edeea\", \"a_f41a7c1ba6156fae3efcbfa8\", \"meta_9de8727634f7ee1e0ff7ee65\"],\n      \"payload\": {\n        \"address_evidence_id\": \"a_f41a7c1ba6156fae3efcbfa8\",\n        \"asdu_type\": 45,\n        \"cause_of_transmission\": 6,\n        \"mapped_control_point_id\": \"cp_e5869e3453530c0a\",\n        \"mapped_target_asset_id\": \"asset_7f51d170f933034a\",\n        \"mapping_evidence_id\": \"meta_9de8727634f7ee1e0ff7ee65\",\n        \"record_id\": \"m_a994e73c7a934146ef7edeea\",\n        \"time\": 0.005490303039550781\n      },\n      \"question_ids\": [\"Q1\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [],\n      \"ch