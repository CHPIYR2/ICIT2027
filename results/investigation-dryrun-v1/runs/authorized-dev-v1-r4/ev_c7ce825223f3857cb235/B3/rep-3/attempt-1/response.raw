          "text": "{\n  \"citation_mode\": \"required\",\n  \"claims\": [\n    {\n      \"asset_ids\": [],\n      \"channel_ids\": [],\n      \"claim_id\": \"c_0001\",\n      \"claim_text\": \"Observation m_14f916d320ad247b5c3593c2 captured iec_i_frame at capture time 0.01835179328918457 s. This does not establish malicious activity.\",\n      \"claim_type\": \"network_activity\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"m_14f916d320ad247b5c3593c2\"],\n      \"payload\": {\n        \"activity\": \"iec_i_frame\",\n        \"record_id\": \"m_14f916d320ad247b5c3593c2\",\n        \"time\": 0.01835179328918457\n      },\n      \"question_ids\": [\"Q1\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [\"asset_b577c35caecef041\"],\n      \"channel_ids\": [],\n      \"claim_id\": \"c_0002\",\n      \"claim_text\": \"Observation m_14f916d320ad247b5c3593c2 with address a_96e11ec1fbccc1753f1fdda8 and mapping meta_72243784d8824a41a4856558 captured a command-type activation request (ASDU 47, COT 6) addressed to control point cp_eec22f800ef36118 mapped to asset asset_b577c35caecef041 at capture time 0.01835179328918457 s. Execution is not established.\",\n      \"claim_type\": \"command_observed\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"m_14f916d320ad247b5c3593c2\", \"a_96e11ec1fbccc1753f1fdda8\", \"meta_72243784d8824a41a4856558\"],\n      \"payload\": {\n        \"address_evidence_id\": \"a_96e11ec1fbccc1753f1fdda8\",\n        \"asdu_type\": 47,\n        \"cause_of_transmission\": 6,\n        \"mapped_control_point_id\": \"cp_eec22f800ef36118\",\n        \"mapped_target_asset_id\": \"asset_b577c35caecef041\",\n        \"mapping_evidence_id\": \"meta_72243784d8824a41a4856558\",\n        \"record_id\": \"m_14f916d320ad247b5c3593c2\",\n        \"time\": 0.01835179328918457\n      },\n      \"question_ids\": [\"Q1\", \"Q3\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [],\n      