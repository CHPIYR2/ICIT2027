          "text": "{\n  \"citation_mode\": \"required\",\n  \"claims\": [\n    {\n      \"asset_ids\": [],\n      \"channel_ids\": [],\n      \"claim_id\": \"c_0001\",\n      \"claim_text\": \"Observation m_ecfe4b015fc2213566ce9786 captured iec_i_frame at capture time 0.012275218963623047 s. This does not establish malicious activity.\",\n      \"claim_type\": \"network_activity\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"m_ecfe4b015fc2213566ce9786\"],\n      \"payload\": {\n        \"activity\": \"iec_i_frame\",\n        \"record_id\": \"m_ecfe4b015fc2213566ce9786\",\n        \"time\": 0.012275218963623047\n      },\n      \"question_ids\": [\"Q1\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [\"asset_0db5971a6db4b1b0\"],\n      \"channel_ids\": [],\n      \"claim_id\": \"c_0002\",\n      \"claim_text\": \"Observation m_ecfe4b015fc2213566ce9786 captured a command-type activation request (ASDU 50, COT 6) at capture time 0.012275218963623047 s. Target mapping is not established; execution is not established.\",\n      \"claim_type\": \"command_observed\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"m_ecfe4b015fc2213566ce9786\"],\n      \"payload\": {\n        \"address_evidence_id\": null,\n        \"asdu_type\": 50,\n        \"cause_of_transmission\": 6,\n        \"mapped_control_point_id\": null,\n        \"mapped_target_asset_id\": null,\n        \"mapping_evidence_id\": null,\n        \"record_id\": \"m_ecfe4b015fc2213566ce9786\",\n        \"time\": 0.012275218963623047\n      },\n      \"question_ids\": [\"Q1\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [\"asset_0db5971a6db4b1b0\"],\n      \"channel_ids\": [],\n      \"claim_id\": \"c_0003\",\n      \"claim_text\": \"Observation m_ecfe4b015fc2213566ce9786 with address a_f77accf485051eceabfe8b67 and mapping meta_ee7fb4e8684fa26ad484cbb9 captured a command-type activation request (ASDU 50, COT 6) addressed to control point cp_3a412ac424ebbb56 mapped to asset asset_0db5971a6db4b1b0 at capture time 0.012275218963623047 s. Execution is not established.\",\n      \"claim_type\": \"command_observed\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"m_ecfe4b015fc2213566ce9786\", \"a_f77accf485051eceabfe8b67\", \"meta_ee7fb4e8684fa26ad484cbb9\"],\n      \"payload\": {\n        \"address_evidence_id\": \"a_f77accf485051eceabfe8b67\",\n        \"asdu_type\": 50,\n        \"cause_of_transmission\": 6,\n        \"mapped_control_point_id\": \"cp_3a412ac424ebbb56\",\n        \"mapped_target_asset_id\": \"asset_0db5971a6db4b1b0\",\n        \"mapping_evidence_id\": \"meta_ee7fb4e8684fa26ad484cbb9\",\n        \"record_id\": \"m_ecfe4b015fc2213566ce9786\",\n        \"time\": 0.012275218963623047\n      },\n      \"question_ids\": [\"Q1\", \"Q3\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [],\n      \"channel_ids\": [],\n      \"claim_id\": \"c_0004\",\n      \"claim_text\": \"Within the approved captured TCP/2404 population, query d_d785e0f5e4921317c485563f reports interval -28.872128009796143 to -27.960256814956665 s, duration 0.9118711948394775 SECOND, bounds p_dd0eebdf71be619d6f2b5aff and p_52c0e5b02350fcfd780abbe5. This does not establish outage, DoS or absence outside the covered scope.\",\n      \"claim_type\": \"communication_gap\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"d_d785e0f5e4921317c485563f\", \"p_dd0eebdf71be619d6f2b5aff\", \"p_52c0e5b02350fcfd780abbe5\"],\n      \"payload\": {\n        \"coverage_id\": \"d_d785e0f5e4921317c485563f\",\n        \"duration_seconds\": 0.9118711948394775,\n        \"end\": -27.960256814956665,\n        \"left_id\": \"p_dd0eebdf71be619d6f2b5aff\",\n        \"population\": \"observed_tcp_2404_packets\",\n        \"right_id\": \"p_52c0e5b02350fcfd780abbe5\",\n        \"start\": -28.872128009796143\n      },\n      \"question_ids\": [\"Q1\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [\"asset_e2ac935da817f983\"],\n      \"channel_ids\": [\"ch_076a19f4adcfcfee\"],\n      \"claim_id\": \"c_0005\",\n      \"claim_text\": \"Observation e_54931bd3ea948dc0af11c502 reported 1.0009344816207886 PER_UNIT on channel ch_076a19f4adcfcfee mapped to asset asset_e2ac935da817f983 at capture time -58.89872980117798 s. This is a reported observation, not independent physical truth.\",\n      \"claim_type\": \"reported_value\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"e_54931bd3ea948dc0af11c502\", \"meta_cecfd900f23c20e8b0685a37\"],\n      \"payload\": {\n        \"record_id\": \"e_54931bd3ea948dc0af11c502\",\n        \"time\": -58.89872980117798,\n        \"unit\": \"PER_UNIT\",\n        \"value\": 1.0009344816207886\n      },\n      \"question_ids\": [\"Q2\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [\"asset_e2ac935da817f983\"],\n      \"channel_ids\": [\"ch_076a19f4adcfcfee\"],\n      \"claim_id\": \"c_0006\",\n      \"claim_text\": \"Observation e_dfa0a79c1779769ffc54dbac reported 1.001348853111267 PER_UNIT on channel ch_076a19f4adcfcfee mapped to asset asset_e2ac935da817f983 at capture time 51.156495094299316 s. This is a reported observation, not independent physical truth.\",\n      \"claim_type\": \"reported_value\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"e_dfa0a79c1779769ffc54dbac\", \"meta_cecfd900f23c20e8b0685a37\"],\n      \"payload\": {\n        \"record_id\": \"e_dfa0a79c1779769ffc54dbac\",\n        \"time\": 51.156495094299316,\n        \"unit\": \"PER_UNIT\",\n        \"value\": 1.001348853111267\n      },\n      \"question_ids\": [\"Q2\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [\"asset_e2ac935da817f983\"],\n      \"channel_ids\": [\"ch_076a19f4adcfcfee\"],\n      \"claim_id\": \"c_0007\",\n      \"claim_text\": \"Reported voltage on channel ch_076a19f4adcfcfee mapped to asset asset_e2ac935da817f983: 1.0009344816207886 PER_UNIT at capture time -58.89872980117798 s (e_54931bd3ea948dc0af11c502), then 1.001348853111267 PER_UNIT at capture time 51.156495094299316 s (e_dfa0a79c1779769ffc54dbac); difference = 0.0004143714904785156 PER_UNIT. This is a reported difference, not evidence of physical execution, causation or malicious intent.\",\n      \"claim_type\": \"reported_change\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"d_a7d7ef59112210f332bd1f87\", \"e_54931bd3ea948dc0af11c502\", \"e_dfa0a79c1779769ffc54dbac\", \"meta_cecfd900f23c20e8b0685a37\"],\n      \"payload\": {\n        \"after_id\": \"e_dfa0a79c1779769ffc54dbac\",\n        \"after_time\": 51.156495094299316,\n        \"after_value\": 1.001348853111267,\n        \"before_id\": \"e_54931bd3ea948dc0af11c502\",\n        \"before_time\": -58.89872980117798,\n        \"before_value\": 1.0009344816207886,\n        \"operation\": \"difference\",\n        \"result\": 0.0004143714904785156,\n        \"unit\": \"PER_UNIT\"\n      },\n      \"question_ids\": [\"Q2\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [\"asset_e2ac935da817f983\"],\n      \"channel_ids\": [\"ch_076a19f4adcfcfee\"],\n      \"claim_id\": \"c_0008\",\n      \"claim_text\": \"Reported voltage on channel ch_076a19f4adcfcfee mapped to asset asset_e2ac935da817f983: 1.0009344816207886 PER_UNIT at capture time -58.89872980117798 s (e_54931bd3ea948dc0af11c502), then 1.001348853111267 PER_UNIT at capture time 51.156495094299316 s (e_dfa0a79c1779769ffc54dbac); percent_change = 0.04139846294510047 PERCENT. This is a reported difference, not evidence of physical execution, causation or malicious intent.\",\n      \"claim_type\": \"reported_change\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"d_a7d7ef59112210f332bd1f87\", \"e_54931bd3ea948dc0af11c502\", \"e_dfa0a79c1779769ffc54dbac\", \"meta_cecfd900f23c20e8b0685a37\"],\n      \"payload\": {\n        \"after_id\": \"e_dfa0a79c1779769ffc54