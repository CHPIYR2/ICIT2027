          "text": "{\n  \"citation_mode\": \"optional_baseline\",\n  \"claims\": [\n    {\n      \"asset_ids\": [],\n      \"channel_ids\": [],\n      \"claim_id\": \"c_0001\",\n      \"claim_text\": \"Observation m_4a3fcb0f1bf577f6c4a82001 captured iec_i_frame at capture time 0.010226964950561523 s. This does not establish malicious activity.\",\n      \"claim_type\": \"network_activity\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"m_4a3fcb0f1bf577f6c4a82001\"],\n      \"payload\": {\n        \"activity\": \"iec_i_frame\",\n        \"record_id\": \"m_4a3fcb0f1bf577f6c4a82001\",\n        \"time\": 0.010226964950561523\n      },\n      \"question_ids\": [\"Q1\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [\"asset_a8a63be8b1f841a1\"],\n      \"channel_ids\": [],\n      \"claim_id\": \"c_0002\",\n      \"claim_text\": \"Observation m_4a3fcb0f1bf577f6c4a82001 with address a_279676ddc4814b7d18dbf624 and mapping meta_43a17ad2fe2ee1e788079b16 captured a command-type activation request (ASDU 45, COT 6) addressed to control point cp_115687746cd27b69 mapped to asset asset_a8a63be8b1f841a1 at capture time 0.010226964950561523 s. Execution is not established.\",\n      \"claim_type\": \"command_observed\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"m_4a3fcb0f1bf577f6c4a82001\", \"a_279676ddc4814b7d18dbf624\", \"meta_43a17ad2fe2ee1e788079b16\"],\n      \"payload\": {\n        \"address_evidence_id\": \"a_279676ddc4814b7d18dbf624\",\n        \"asdu_type\": 45,\n        \"cause_of_transmission\": 6,\n        \"mapped_control_point_id\": \"cp_115687746cd27b69\",\n        \"mapped_target_asset_id\": \"asset_a8a63be8b1f841a1\",\n        \"mapping_evidence_id\": \"meta_43a17ad2fe2ee1e788079b16\",\n        \"record_id\": \"m_4a3fcb0f1bf577f6c4a82001\",\n        \"time\": 0.010226964950561523\n      },\n      \"question_ids\": [\"Q1\", \"Q3\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\"