          "text": "{\n  \"citation_mode\": \"optional_baseline\",\n  \"claims\": [\n    {\n      \"asset_ids\": [],\n      \"channel_ids\": [],\n      \"claim_id\": \"c_0001\",\n      \"claim_text\": \"Observation m_352e158899d972bf6f46b881 captured iec_i_frame at capture time 0.11843752861022949 s. This does not establish malicious activity.\",\n      \"claim_type\": \"network_activity\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"m_352e158899d972bf6f46b881\"],\n      \"payload\": {\n        \"activity\": \"iec_i_frame\",\n        \"record_id\": \"m_352e158899d972bf6f46b881\",\n        \"time\": 0.11843752861022949\n      },\n      \"question_ids\": [\"Q1\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [\"asset_a8faae0835d519cc\"],\n      \"channel_ids\": [\"ch_9f622a6f05348863\"],\n      \"claim_id\": \"c_0002\",\n      \"claim_text\": \"Observation e_9a41a420d02b626e8a18de0e reported true NONE on channel ch_9f622a6f05348863 mapped to asset asset_a8faae0835d519cc at capture time 0.5561783313751221 s. This is a reported observation, not independent physical truth.\",\n      \"claim_type\": \"reported_value\",\n      \"endpoint_ids\": [],\n      \"evidence_ids\": [\"e_9a41a420d02b626e8a18de0e\"],\n      \"payload\": {\n        \"record_id\": \"e_9a41a420d02b626e8a18de0e\",\n        \"time\": 0.5561783313751221,\n        \"unit\": \"NONE\",\n        \"value\": true\n      },\n      \"question_ids\": [\"Q2\"],\n      \"support_assertion\": \"asserted\"\n    },\n    {\n      \"asset_ids\": [\"asset_0317cb9fd3bf043d\"],\n      \"channel_ids\": [\"ch_15051b36e2f7a357\"],\n      \"claim_id\": \"c_0003\",\n      \"claim_text\": \"Observation e_39b73eb78d0121007d523c89 reported false NONE on channel ch_15051b36e2f7a357 mapped to asset asset_0317cb9fd3bf043d at capture time 20.463557481765747 s. This is a reported observation, not independent physical truth.\",\n      \"claim_type\": \"reported_value\",\n      \"endpoint_ids\