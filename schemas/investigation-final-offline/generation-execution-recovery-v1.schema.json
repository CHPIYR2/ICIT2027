{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "generation-execution-recovery-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "experimental_protocol_changed",
    "run_id",
    "model",
    "pre_execution_generation_manifest_sha256",
    "interrupted_execution_result_sha256",
    "scheduled_positions",
    "completed_model_response_positions",
    "schema_valid_model_responses",
    "schema_invalid_model_responses",
    "billing_failed_no_output_positions",
    "pending_undispatched_positions",
    "ambiguous_delivery_count",
    "reason",
    "semantic_output_or_gold_review_used_to_select_recovery",
    "schema_invalid_http_200_outputs_retained",
    "schema_invalid_http_200_outputs_regenerated",
    "recovery_eligibility",
    "canonical_schedule_unchanged",
    "experiment_identity_preserved",
    "same_request_object_and_sha256_preserved_for_billing_failures",
    "cumulative_provider_attempt_history_preserved",
    "successful_model_response_positions_cannot_be_rerun",
    "recovery_continues_same_experimental_position",
    "recovered_billing_failure_is_not_a_new_sample",
    "three_attempt_compatibility",
    "exception_scope",
    "resume_order",
    "future_execution_seal",
    "provider_calls_during_freeze",
    "canonical_positions",
    "pre_resume_checks",
    "recovery_sha256"
  ],
  "properties": {
    "version": {"const": "generation-execution-recovery-v1"},
    "kind": {"const": "operational_execution_record"},
    "experimental_protocol_changed": {"const": false},
    "run_id": {"const": "authorized-final-evaluation-v1"},
    "model": {"const": "gpt-4.1-2025-04-14"},
    "pre_execution_generation_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interrupted_execution_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scheduled_positions": {"const": 384},
    "completed_model_response_positions": {"const": 44},
    "schema_valid_model_responses": {"const": 42},
    "schema_invalid_model_responses": {"const": 2},
    "billing_failed_no_output_positions": {"const": 26},
    "pending_undispatched_positions": {"const": 314},
    "ambiguous_delivery_count": {"const": 0},
    "reason": {"const": "credit_balance_exhausted"},
    "semantic_output_or_gold_review_used_to_select_recovery": {"const": false},
    "schema_invalid_http_200_outputs_retained": {"const": true},
    "schema_invalid_http_200_outputs_regenerated": {"const": false},
    "recovery_eligibility": {"const": "positions_with_no_model_response_only"},
    "canonical_schedule_unchanged": {"const": true},
    "experiment_identity_preserved": {"const": true},
    "same_request_object_and_sha256_preserved_for_billing_failures": {"const": true},
    "cumulative_provider_attempt_history_preserved": {"const": true},
    "successful_model_response_positions_cannot_be_rerun": {"const": true},
    "recovery_continues_same_experimental_position": {"const": true},
    "recovered_billing_failure_is_not_a_new_sample": {"const": true},
    "three_attempt_compatibility": {"const": "PER_SESSION_TRANSPORT_CAP_THEN_PERMANENT_COMPLETED_LOCK_NO_PREEXISTING_RECOVERY"},
    "exception_scope": {"const": "credit_balance_exhausted_positions_with_zero_model_output"},
    "resume_order": {"const": "earliest_unresolved_position_in_canonical_schedule"},
    "future_execution_seal": {"const": "new_post_resume_seal_referencing_pre_execution_manifest_interrupted_seal_and_this_addendum"},
    "provider_calls_during_freeze": {"const": 0},
    "canonical_positions": {
      "type": "array",
      "minItems": 384,
      "maxItems": 384,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["position_id", "event_id", "cell_id", "repetition", "role", "request_sha256", "output_sha256", "status", "attempt_count", "next_attempt_number", "unsent_attempt_directories"],
        "properties": {
          "position_id": {"type": "string", "minLength": 1},
          "event_id": {"type": "string", "minLength": 1},
          "cell_id": {"enum": ["G0", "G1-E", "G1-N", "G1-EN"]},
          "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
          "role": {"enum": ["completed_model_response", "billing_failed_no_output", "undispatched"]},
          "request_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
          "output_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
          "status": {"type": "string", "minLength": 1},
          "attempt_count": {"type": "integer", "minimum": 0, "maximum": 3},
          "next_attempt_number": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
          "unsent_attempt_directories": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 3}}
        }
      }
    },
    "pre_resume_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "recovery_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
