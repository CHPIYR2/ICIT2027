{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "investigation-verification-v2"
    },
    "input_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^c_[0-9]{1,4}$"
          },
          "status": {
            "enum": [
              "SUPPORTED",
              "QUALIFIED",
              "INSUFFICIENT"
            ]
          },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reference": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_APPLICABLE",
                  "NOT_CHECKABLE"
                ]
              },
              "visibility": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_APPLICABLE",
                  "NOT_CHECKABLE"
                ]
              },
              "asset": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_APPLICABLE",
                  "NOT_CHECKABLE"
                ]
              },
              "time": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_APPLICABLE",
                  "NOT_CHECKABLE"
                ]
              },
              "numerical": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_APPLICABLE",
                  "NOT_CHECKABLE"
                ]
              },
              "unit": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_APPLICABLE",
                  "NOT_CHECKABLE"
                ]
              },
              "lineage": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_APPLICABLE",
                  "NOT_CHECKABLE"
                ]
              },
              "claim_policy": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_APPLICABLE",
                  "NOT_CHECKABLE"
                ]
              }
            },
            "required": [
              "reference",
              "visibility",
              "asset",
              "time",
              "numerical",
              "unit",
              "lineage",
              "claim_policy"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "enum": [
                "invalid_schema",
                "unknown_reference",
                "hidden_reference",
                "unretrieved_reference",
                "asset_mismatch",
                "mapping_unavailable",
                "time_mismatch",
                "number_mismatch",
                "unit_mismatch",
                "lineage_invalid",
                "quality_invalid",
                "incomplete_query",
                "unsupported_interpretation",
                "unverified_free_text",
                "no_support",
                "weaker_projection_only"
              ]
            },
            "uniqueItems": true
          },
          "supported_projection": {
            "anyOf": [
              {
                "$ref": "#/$defs/claim"
              },
              {
                "type": "null"
              }
            ]
          },
          "presentation": {
            "enum": [
              "emit_supported",
              "emit_qualified",
              "withhold"
            ]
          }
        },
        "required": [
          "claim_id",
          "status",
          "checks",
          "reason_codes",
          "supported_projection",
          "presentation"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "input_report_sha256",
    "policy_sha256",
    "results"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activity": {
          "enum": [
            "packet_observed",
            "iec_i_frame",
            "iec_s_frame",
            "iec_u_frame",
            "tcp_rst_observed"
          ]
        },
        "record_id": {
          "type": "string",
          "pattern": "^(?:p_[0-9a-f]{24}|m_[0-9a-f]{24})$"
        },
        "time": {
          "type": "number",
          "minimum": -60,
          "exclusiveMaximum": 60
        }
      },
      "required": [
        "activity",
        "record_id",
        "time"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^(?:m_[0-9a-f]{24})$"
        },
        "asdu_type": {
          "enum": [
            45,
            47,
            50
          ]
        },
        "cause_of_transmission": {
          "const": 6
        },
        "time": {
          "type": "number",
          "minimum": -60,
          "exclusiveMaximum": 60
        },
        "address_evidence_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:a_[0-9a-f]{24})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mapping_evidence_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:meta_[0-9a-f]{24})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mapped_control_point_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:cp_[0-9a-f]{16})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mapped_target_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:asset_[0-9a-f]{16})$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record_id",
        "asdu_type",
        "cause_of_transmission",
        "time",
        "address_evidence_id",
        "mapping_evidence_id",
        "mapped_control_point_id",
        "mapped_target_asset_id"
      ]
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^(?:p_[0-9a-f]{24}|m_[0-9a-f]{24})$"
        },
        "kind": {
          "enum": [
            "tcp_ack_bit",
            "iec_s_frame",
            "iec_activation_confirmation"
          ]
        },
        "time": {
          "type": "number",
          "minimum": -60,
          "exclusiveMaximum": 60
        }
      },
      "required": [
        "record_id",
        "kind",
        "time"
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage_id": {
          "type": "string",
          "pattern": "^(?:d_[0-9a-f]{24})$"
        },
        "left_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:p_[0-9a-f]{24})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "right_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:p_[0-9a-f]{24})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "type": "number",
          "minimum": -60,
          "maximum": 60
        },
        "end": {
          "type": "number",
          "minimum": -60,
          "maximum": 60
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "population": {
          "const": "observed_tcp_2404_packets"
        }
      },
      "required": [
        "coverage_id",
        "left_id",
        "right_id",
        "start",
        "end",
        "duration_seconds",
        "population"
      ]
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^(?:e_[0-9a-f]{24})$"
        },
        "value": {
          "type": [
            "number",
            "boolean"
          ]
        },
        "unit": {
          "enum": [
            "PER_UNIT",
            "AMPERE",
            "WATT",
            "VAR",
            "NONE",
            "PERCENT",
            "SECOND",
            "COUNT"
          ]
        },
        "time": {
          "type": "number",
          "minimum": -60,
          "exclusiveMaximum": 60
        }
      },
      "required": [
        "record_id",
        "value",
        "unit",
        "time"
      ]
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before_id": {
          "type": "string",
          "pattern": "^(?:e_[0-9a-f]{24})$"
        },
        "after_id": {
          "type": "string",
          "pattern": "^(?:e_[0-9a-f]{24})$"
        },
        "before_value": {
          "type": "number"
        },
        "after_value": {
          "type": "number"
        },
        "operation": {
          "enum": [
            "difference",
            "percent_change"
          ]
        },
        "result": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "PER_UNIT",
            "AMPERE",
            "WATT",
            "VAR",
            "NONE",
            "PERCENT",
            "SECOND",
            "COUNT"
          ]
        },
        "before_time": {
          "type": "number",
          "minimum": -60,
          "exclusiveMaximum": 60
        },
        "after_time": {
          "type": "number",
          "minimum": -60,
          "exclusiveMaximum": 60
        }
      },
      "required": [
        "before_id",
        "after_id",
        "before_value",
        "after_value",
        "operation",
        "result",
        "unit",
        "before_time",
        "after_time"
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before_id": {
          "type": "string",
          "pattern": "^(?:e_[0-9a-f]{24})$"
        },
        "after_id": {
          "type": "string",
          "pattern": "^(?:e_[0-9a-f]{24})$"
        },
        "before_value": {
          "type": "boolean"
        },
        "after_value": {
          "type": "boolean"
        },
        "before_time": {
          "type": "number",
          "minimum": -60,
          "exclusiveMaximum": 60
        },
        "after_time": {
          "type": "number",
          "minimum": -60,
          "exclusiveMaximum": 60
        }
      },
      "required": [
        "before_id",
        "after_id",
        "before_value",
        "after_value",
        "before_time",
        "after_time"
      ]
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "earlier_id": {
          "type": "string",
          "pattern": "^(?:p_[0-9a-f]{24}|m_[0-9a-f]{24}|e_[0-9a-f]{24}|a_[0-9a-f]{24})$"
        },
        "later_id": {
          "type": "string",
          "pattern": "^(?:p_[0-9a-f]{24}|m_[0-9a-f]{24}|e_[0-9a-f]{24}|a_[0-9a-f]{24})$"
        },
        "relation": {
          "enum": [
            "precedes",
            "same_capture_time"
          ]
        },
        "delta_seconds": {
          "type": "number",
          "minimum": 0
        },
        "scope": {
          "enum": [
            "episode_only",
            "same_observed_asset"
          ]
        },
        "mapping_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:meta_[0-9a-f]{24})$"
          },
          "uniqueItems": true
        },
        "mapped_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:asset_[0-9a-f]{16})$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "earlier_id",
        "later_id",
        "relation",
        "delta_seconds",
        "scope",
        "mapping_ids",
        "mapped_asset_id"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relation": {
          "enum": [
            "same_mapped_asset",
            "packet_endpoint_pair",
            "command_address_maps_to_asset"
          ]
        },
        "record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:p_[0-9a-f]{24}|m_[0-9a-f]{24}|e_[0-9a-f]{24}|a_[0-9a-f]{24})$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "mapping_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:meta_[0-9a-f]{24})$"
          },
          "uniqueItems": true
        },
        "mapped_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:asset_[0-9a-f]{16})$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "relation",
        "record_ids",
        "mapping_ids",
        "mapped_asset_id"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "relation": {
                "const": "same_mapped_asset"
              }
            }
          },
          "then": {
            "properties": {
              "record_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:e_[0-9a-f]{24})$"
                },
                "minItems": 2,
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relation": {
                "const": "packet_endpoint_pair"
              }
            }
          },
          "then": {
            "properties": {
              "record_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:p_[0-9a-f]{24})$"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relation": {
                "const": "command_address_maps_to_asset"
              }
            }
          },
          "then": {
            "properties": {
              "record_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:m_[0-9a-f]{24}|a_[0-9a-f]{24})$"
                },
                "minItems": 2,
                "uniqueItems": true
              }
            }
          }
        }
      ]
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "indicator": {
          "enum": [
            "tcp_rst_present",
            "command_request_present",
            "captured_gap_present",
            "reported_numeric_difference"
          ]
        },
        "basis_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:p_[0-9a-f]{24}|m_[0-9a-f]{24}|e_[0-9a-f]{24}|d_[0-9a-f]{24})$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "interpretation": {
          "const": "review_relevant_observation_not_attack_proof"
        }
      },
      "required": [
        "indicator",
        "basis_ids",
        "interpretation"
      ]
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "enum": [
            "review_required",
            "causation_established",
            "malicious_intent",
            "attacker_identified",
            "successful_compromise",
            "physical_execution_completed",
            "benign_or_safe"
          ]
        },
        "basis_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:p_[0-9a-f]{24}|m_[0-9a-f]{24}|e_[0-9a-f]{24}|d_[0-9a-f]{24})$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "conclusion",
        "basis_ids"
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "view_excluded",
            "not_retrieved",
            "no_observation",
            "no_valid_pair",
            "ambiguous_asset_mapping",
            "quality_flagged",
            "no_measurement_time",
            "policy_disallows_inference",
            "insufficient_support",
            "generation_failed"
          ]
        },
        "missing_requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "scope_id": {
          "type": "string",
          "pattern": "^(?:d_[0-9a-f]{24})$"
        },
        "attempted_conclusion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "reason",
        "missing_requirement",
        "scope_id",
        "attempted_conclusion"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^c_[0-9]{1,4}$"
        },
        "question_ids": {
          "type": "array",
          "items": {
            "enum": [
              "Q1",
              "Q2",
              "Q3",
              "Q4",
              "Q5",
              "Q6",
              "Q7"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "claim_type": {
          "enum": [
            "network_activity",
            "command_observed",
            "acknowledgement_observed",
            "communication_gap",
            "reported_value",
            "reported_change",
            "reported_state_change",
            "electrical_change",
            "temporal_association",
            "asset_relationship",
            "security_indicator",
            "security_interpretation",
            "unknown"
          ]
        },
        "claim_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "support_assertion": {
          "enum": [
            "asserted",
            "insufficient"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:p_[0-9a-f]{24}|m_[0-9a-f]{24}|e_[0-9a-f]{24}|a_[0-9a-f]{24}|d_[0-9a-f]{24}|meta_[0-9a-f]{24})$"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^asset_[0-9a-f]{16}$"
          },
          "uniqueItems": true
        },
        "channel_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ch_[0-9a-f]{16}$"
          },
          "uniqueItems": true
        },
        "endpoint_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ep_[0-9a-f]{16}$"
          },
          "uniqueItems": true
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "claim_id",
        "question_ids",
        "claim_type",
        "claim_text",
        "support_assertion",
        "evidence_ids",
        "asset_ids",
        "channel_ids",
        "endpoint_ids",
        "payload"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "network_activity"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/network"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "command_observed"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/command"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "acknowledgement_observed"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/ack"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "communication_gap"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/gap"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "reported_value"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "reported_change"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/delta"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "reported_state_change"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/state"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "electrical_change"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/delta"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "temporal_association"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/temporal"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "asset_relationship"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/asset"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "security_indicator"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/indicator"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "security_interpretation"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/interpretation"
              }
            }
          }
